<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络与后台播放所需权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) 起，前台服务若声明 foregroundServiceType="mediaPlayback"，
         必须同时持有 FOREGROUND_SERVICE_MEDIA_PLAYBACK，否则 startForeground() 抛
         SecurityException。本项目 targetSdk=36，缺这一条会让 audio_service 初始化失败，
         并在启动路径上表现为「黑屏」。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV 声明：非触屏设备也可安装 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="XX音乐"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视主屏入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- audio_service：后台播放 + MediaSession + 遥控媒体键。
             ⚠️ V5 修复：类名必须是 `com.ryanheise.audioservice.AudioService`。
             本项目原先写的是 `...MediaPlaybackService` —— 那是 audio_service
             0.17.x 的类名，在 0.18.x（本工程 pinned `^0.18.15`）的 jar 里
             **根本不存在这个类**（官方源码目录只有 AudioService.java、
             AudioServiceActivity.java、MediaButtonReceiver.java …）。
             声明一个不存在的 service 的后果：`startService`/`bindService`
             找不到组件，前台服务起不来，MediaSession 与媒体键全部失效，
             而且不会在启动路径上抛出显眼的异常 —— 与图1里
             「Activity 未提供正确 FlutterEngine」是**两个独立的错**，
             两个都必须修。 -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- audio_service 官方 Android setup 要求的媒体键接收器。
             缺了它，电视遥控器/蓝牙耳机上的播放暂停、上一首、下一首
             **不会有任何反应**（广播无人接收，且同样静默失败）。
             Android 12+ 起 exported 必须显式声明，否则清单合并报错。 -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ══ 渲染后端：这里**刻意不写死任何值** ══

             ⚠️ 历史结论已撤回。本工程曾经：
               1) 先写 EnableImpeller=false（想回退 Skia），
               2) 又断言「Flutter 3.47 已移除 Android 10+ 的 Skia 后端，无法关闭
                  Impeller」，据此改成写死 ImpellerBackend=opengles。
             这两个结论一个是推测、一个基于未经验证的搜索结论，都没有实机证据。
             更严重的是：**写死 ImpellerBackend=opengles 会直接消灭「Impeller 默认
             后端」这个对照组** —— 测试退化成只能验证一个后端，无法 A/B。

             现在改为：默认**不带任何渲染 meta-data**，即让 Flutter 自行选择默认后端。
             需要做 A/B 对比时，由 tools/diag/make_variant.py 在下面两个锚点之间插入
             对应的 meta-data，生成多个诊断 APK：

               EnableImpeller=false            → 关闭 Impeller（A / D）
               ImpellerBackend=opengles        → 钉在 OpenGL ES（C）
               （不插入）                       → Flutter 默认后端（B / E / F）

             锚点不要删：诊断构建脚本依赖它定位。 -->
        <!-- ▼ DIAG_RENDERER_ANCHOR -->
        <!-- ▲ DIAG_RENDERER_ANCHOR_END -->
    </application>

    <!-- Flutter 3.47.6 官方模板新增：允许引擎查询可处理文本的 Activity
         （io.flutter.plugin.text.ProcessTextPlugin 需要）。
         本次迁移只新增此块，未改动任何既有 TV / Leanback / MediaSession 声明。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 输入法可见性（Android 11+ 包可见性）：
             登录页要用 InputMethodManager.getEnabledInputMethodList() 读出
             「这台电视到底有没有可用输入法」，把结论显示在屏幕上（电视没有 adb）。
             不声明 queries 时该调用返回空列表，会把「有输入法但被过滤」误判成「没有输入法」。
             ⚠️ 只查询输入法能力，不涉及任何凭据。 -->
        <intent>
            <action android:name="android.view.InputMethod"/>
        </intent>
    </queries>
</manifest>
