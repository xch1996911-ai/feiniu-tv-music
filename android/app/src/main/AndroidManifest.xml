<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络与后台播放所需权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) 起，前台服务若声明 foregroundServiceType="mediaPlayback"，
         必须同时持有 FOREGROUND_SERVICE_MEDIA_PLAYBACK，否则 startForeground() 抛
         SecurityException。本项目 targetSdk=36，缺这一条会让 audio_service 初始化失败，
         并在启动路径上表现为「黑屏」。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV 声明：非触屏设备也可安装 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="飞牛 TV 音乐"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视主屏入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- audio_service：后台播放 + MediaSession + 遥控媒体键 -->
        <service
            android:name="com.ryanheise.audioservice.MediaPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 渲染后端选择。
             ⚠️ 这里曾经写的是 EnableImpeller=false（想回退到 Skia），在 Flutter
             3.47.6 上**已经过时且无效**：Android 10+ 的 Skia 后端已被上游移除
             （3.38 deprecate → 3.41/3.44 removed），Impeller 是唯一渲染路径。
             继续留着那条 meta-data 只会让「黑屏」的归因变得模糊。

             真正的问题在 Vulkan：部分 Android TV / 电视盒子的 Vulkan 驱动不完整，
             Impeller 默认 Vulkan 后端会出现「进程存活、音频正常、画面全黑」。
             因此改成显式把 Impeller 后端钉在 OpenGL ES（官方支持的后端切换，
             见 ImpellerBackend 说明），绕开有缺陷的 Vulkan 驱动。 -->
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles" />
    </application>

    <!-- Flutter 3.47.6 官方模板新增：允许引擎查询可处理文本的 Activity
         （io.flutter.plugin.text.ProcessTextPlugin 需要）。
         本次迁移只新增此块，未改动任何既有 TV / Leanback / MediaSession 声明。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
